{
  // Dedicated RSI candidate-execution lab worker. Separate deploy unit from
  // retaste-beta: no routes, no crons, no D1/R2, no shared secrets. Deploy,
  // paid-plan transition and RSI_LAB_TOKEN secret setup are a separate
  // approved operations step — this file alone deploys nothing.
  // Plan: docs/superpowers/plans/2026-11-04-rsi-cloudflare-sandbox.md (Issue #331)
  "name": "retaste-rsi-sandbox",
  "main": "./workers/rsi-sandbox.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./workers/rsi-sandbox.Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "Sandbox", "name": "Sandbox" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["Sandbox"], "tag": "v1" }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "persist": true, "head_sampling_rate": 1 }
  }
}
