diff --git a/app/features/places/place.server.ts b/app/features/places/place.server.ts
index 2c12e54..d7e3666 100644
--- a/app/features/places/place.server.ts
+++ b/app/features/places/place.server.ts
@@ -161,0 +162,16 @@ function publicConditions(filters: PlaceFilters, slug?: string) {
+export async function isEligibleOfficialPhotoPlace(db: AppDb, place: { id: string; name: string; address: string }) {
+  const [eligible] = await db.select({ id: places.id }).from(places)
+    .innerJoin(placeCategories, eq(placeCategories.placeId, places.id))
+    .innerJoin(categories, eq(categories.id, placeCategories.categoryId))
+    .where(and(
+      publicConditions({}),
+      eq(places.id, place.id),
+      eq(places.name, place.name),
+      eq(places.address, place.address),
+      sql`${places.closedAt} is null`,
+      sql`not exists (select 1 from temp_catalog_entries t join temp_catalog_batches b
+        on b.id=t.batch_id where t.place_id=${places.id} and b.status='PUBLISHED')`,
+    )).limit(1);
+  return Boolean(eligible);
+}
+
