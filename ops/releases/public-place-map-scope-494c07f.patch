new file mode 100644
--- /dev/null
+++ b/app/features/places/public-place-map-scope.ts
@@ -0,0 +1,36 @@
+import { parseMapState } from "../maps/map-state";
+
+export function readPublicPlaceMapScope(search: string, routeCategorySlug?: string) {
+  const params = new URLSearchParams(search);
+  const state = parseMapState(search);
+  const tempOnly = params.get("temp") === "1";
+  return {
+    state,
+    filters: {
+      categorySlug: routeCategorySlug ?? (params.get("category") || undefined),
+      query: state.query,
+      bbox: tempOnly ? undefined : state.bbox,
+      tempOnly,
+    },
+  };
+}
+
+export function publicPlaceMapScopeHref(destination: "map" | "list", search: string, options: {
+  categorySlug?: string;
+  selected?: string | null;
+  badges?: readonly string[];
+} = {}) {
+  const current = new URLSearchParams(search);
+  const next = new URLSearchParams();
+  if (destination === "map") next.set("view", "browse");
+  for (const key of ["q", "category", "bbox"]) {
+    const value = current.get(key);
+    if (value) next.set(key, value);
+  }
+  if (options.categorySlug) next.set("category", options.categorySlug);
+  if (current.get("temp") === "1") next.set("temp", "1");
+  for (const badge of options.badges ?? current.getAll("badge")) next.append("badge", badge);
+  if (options.selected) next.set("selected", options.selected);
+  if (current.has("qa")) next.set("qa", "1");
+  return `${destination === "map" ? "/" : "/places"}${next.size ? `?${next}` : ""}`;
+}
