{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retaste-e2e",
  "compatibility_date": "2026-08-05",
  "main": "./tests/e2e/local-email-worker.ts",
  "vars": {
    "STUDENT_INVITE_COOKIE_SECRET": "synthetic-e2e-session-secret-not-production",
    "STUDENT_WORKSPACE_ENABLED": "true",
    "RESEND_API_KEY": "local-e2e-email-fake",
    "RESEND_FROM_EMAIL": "test@example.test",
    "ONBOARDING_ENABLED": "true",
    "REVIEW_AUTO_PIPELINE_ENABLED": "true",
    "NAVER_MAPS_CLIENT_ID": "e2e-naver-map-client",
    "NAVER_PLACE_GEOCODING_ENABLED": "true",
    "REVIEW_PHOTO_UPLOAD_ENABLED": "true",
    "POI_MEDIA_PUBLIC_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "retaste-e2e-local",
      "database_id": "00000000-0000-4000-8000-000000000e2e",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "REVIEW_PHOTOS",
      "bucket_name": "retaste-review-photos-e2e"
    }
  ],
  "compatibility_flags": ["nodejs_compat"]
}
