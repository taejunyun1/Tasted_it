/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "retaste-beta",
	"compatibility_date": "2026-08-05",
	"main": "./workers/app.ts",
	// maintenance `17 18 * * *`, RSI `47 */6 * * *`. scheduled()가 cron 식으로 갈라 실행한다.
	"triggers": { "crons": ["17 18 * * *", "47 */6 * * *"] },
	"preview_urls": false,
	"vars": {
		// 운영자가 지정한 도메인 하나만 복구. 기본 비활성, 복구 후 다시 비운다.
		"EMAIL_DOMAIN_REPAIR_TARGET": "",
		"STUDENT_WORKSPACE_ENABLED": "true",
		"ONBOARDING_ENABLED": "true",
		"NAVER_PLACE_GEOCODING_ENABLED": "true",
		"NAVER_LOCAL_SEARCH_ENABLED": "true",
		"NAVER_LOCAL_SEARCH_DAILY_LIMIT": "20000",
		"REVIEW_PHOTO_UPLOAD_ENABLED": "false",
		"PLACE_CATEGORY_V5_ENABLED": "false",
		"COURSE_CONTEXT_V2_ENABLED": "false",
		// 검수 1→4 조건부 이동. true여도 공개·NAVER 호출 없음. 끄려면 "false".
		"REVIEW_CONFIDENT_ADVANCE_ENABLED": "true",
		// RSI 자검. 기존 maintenance Promise.all에 넣지 않음. 끄려면 "false".
		"RSI_CLOUDFLARE_ENABLED": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "retaste-production",
			"database_id": "5181489d-83a7-4f78-9384-db096cadaa2d",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "REVIEW_PHOTOS",
			"bucket_name": "retaste-review-photos",
			"preview_bucket_name": "retaste-review-photos-preview"
		}
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"persist": true
		}
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	]
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": {  "directory": "./public/",  "binding": "ASSETS" }
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
